{
  "name": "chromium-customizer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "web-ext:dev": "web-ext run --source-dir=dist --start-url=about:blank",
    "web-ext:build": "web-ext build --source-dir=dist --artifacts-dir=web-ext-artifacts"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.23",
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/webextension-polyfill": "^0.10.7",
    "@vitejs/plugin-react": "^4.2.0",
    "monaco-editor": "^0.45.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "web-ext": "^7.10.0"
  }
}
